# ═══════════════════════════════════════════════════════════════
#  HOME ENERGY MONITOR
#  ESP32-S3 Mini + 2x ADS1115
# ═══════════════════════════════════════════════════════════════
#
#  HARDWARE
#
#  ESP32-S3 Mini (Super Mini / WeAct or compatible)
#    - USB-C powered
#    - GPIO8  = SDA
#    - GPIO9  = SCL
#
#  ADS1115 #1 — address 0x48 — CURRENT
#    ADDR -> GND
#
#    A0 = SCT013-000 service entrance L1
#    A1 = SCT013-000 service entrance L2
#    A2 = SCT013-000 generator L1
#    A3 = SCT013-000 generator L2
#
#  ADS1115 #2 — address 0x49 — VOLTAGE
#    ADDR -> VDD
#
#    A0 = ZMPT101B service L1 -> neutral
#    A1 = ZMPT101B service L2 -> neutral
#
#
# ═══════════════════════════════════════════════════════════════
#  DUAL-CORE STRATEGY
# ═══════════════════════════════════════════════════════════════
#
#  ESP32-S3 has two Xtensa LX7 cores at 240 MHz.
#  ESPHome on ESP32 automatically pins the WiFi/network stack
#  to core 0 and the application (sensor polling, MQTT, API)
#  to core 1. No manual pinning needed in YAML -- ESPHome
#  handles this by default when compiled for ESP32.
#
#  This is the fundamental fix for the ESP8266 jitter problem:
#  the WiFi stack can no longer interrupt a ct_clamp sampling
#  window because it runs on a completely separate core.
#
#
# ═══════════════════════════════════════════════════════════════
#  MEASUREMENT NOTES
# ═══════════════════════════════════════════════════════════════
#
#  CURRENT:
#
#  SCT013-000: 100A primary -> 50mA secondary, 20 ohm burden
#    1.0 V RMS CT signal -> 100 A (initial calibration)
#    Verify against a clamp meter and adjust calibrate_linear.
#
#  Gain:
#    Current channels use gain 4.096 (+-4.096V range).
#    At 100A the CT produces 1.0V RMS -> 1.414V peak.
#    Safe headroom within 4.096V range.
#
#  Only mains OR generator is live at any given time.
#  Both sets are polled continuously -- whichever has no
#  load will just read near zero. No switching needed.
#
#
#  VOLTAGE:
#
#  ZMPT101B adjusted to ~0.20V RMS output at ~124V mains.
#  Calibration point: 0.20 -> 124.0
#  Verify against a properly rated multimeter and adjust.
#
#  Gain:
#    Voltage channels use gain 2.048 (+-2.048V range).
#    At 0.20V RMS the ZMPT peak is ~0.283V.
#    With ~1.65V DC bias the positive peak is ~1.93V.
#    Safe within 2.048V range.
#
#
#  POWER:
#
#  Apparent power only (VA = Vrms x Arms).
#  Not true real power -- no power factor correction.
#  Accurate for resistive loads; motors/compressors will read
#  slightly higher than actual real power consumption.
#
#
# ═══════════════════════════════════════════════════════════════
#  GENERATOR LOAD
# ═══════════════════════════════════════════════════════════════

substitutions:
  device_name: "home-energy-monitor"
  friendly_name: "Home Energy Monitor"
  generator_rated_amps: "30.0"


# ═══════════════════════════════════════════════════════════════
#  ESPHOME / PLATFORM
# ═══════════════════════════════════════════════════════════════

esphome:
  name: ${device_name}
  friendly_name: ${friendly_name}


esp32:
  board: esp32-s3-devkitc-1
  variant: esp32s3
  framework:
    type: arduino


logger:
  hardware_uart: UART0


# ═══════════════════════════════════════════════════════════════
#  HOME ASSISTANT API
# ═══════════════════════════════════════════════════════════════

api:
  encryption:
    key: !secret home_energy_monitor__api_encryption_key


# ═══════════════════════════════════════════════════════════════
#  OTA
# ═══════════════════════════════════════════════════════════════

ota:
  - platform: esphome
    password: !secret ota_password


# ═══════════════════════════════════════════════════════════════
#  WIFI
# ═══════════════════════════════════════════════════════════════

wifi:
  ssid: !secret wifi_ssid
  password: !secret wifi_password
  ap:
    ssid: "${friendly_name} Fallback"

captive_portal:


# ═══════════════════════════════════════════════════════════════
#  TIME
# ═══════════════════════════════════════════════════════════════

time:
  - platform: homeassistant
    id: ha_time


# ═══════════════════════════════════════════════════════════════
#  I2C
#  GPIO8 = SDA, GPIO9 = SCL on ESP32-S3 Mini
# ═══════════════════════════════════════════════════════════════

i2c:
  sda: GPIO8
  scl: GPIO9
  scan: true
  frequency: 400kHz


# ═══════════════════════════════════════════════════════════════
#  ADS1115
#
#  continuous_mode is OFF on both.
#  Known ESPHome bug: continuous_mode + multiple ADS1115 +
#  ct_clamp causes sampling conflicts. One-shot mode is stable.
# ═══════════════════════════════════════════════════════════════

ads1115:

  - address: 0x48
    id: ads_current

  - address: 0x49
    id: ads_voltage


# ═══════════════════════════════════════════════════════════════
#  SENSORS
# ═══════════════════════════════════════════════════════════════

sensor:


  # ════════════════════════════════════════════════════════════
  #  CURRENT — RAW ADS1115 CHANNELS
  #
  #  All 4 channels polled continuously.
  #  Mains and generator are never both live, but we read both
  #  all the time -- the inactive source just reads near zero.
  #  Gain 4.096 on all current channels.
  # ════════════════════════════════════════════════════════════

  - platform: ads1115
    id: raw_service_l1
    ads1115_id: ads_current
    multiplexer: 'A0_GND'
    gain: 4.096
    sample_rate: 860
    update_interval: 1s
    internal: true

  - platform: ads1115
    id: raw_service_l2
    ads1115_id: ads_current
    multiplexer: 'A1_GND'
    gain: 4.096
    sample_rate: 860
    update_interval: 1s
    internal: true

  - platform: ads1115
    id: raw_generator_l1
    ads1115_id: ads_current
    multiplexer: 'A2_GND'
    gain: 4.096
    sample_rate: 860
    update_interval: 1s
    internal: true

  - platform: ads1115
    id: raw_generator_l2
    ads1115_id: ads_current
    multiplexer: 'A3_GND'
    gain: 4.096
    sample_rate: 860
    update_interval: 1s
    internal: true


  # ════════════════════════════════════════════════════════════
  #  CURRENT — RMS / CALIBRATED
  #
  #  sample_duration: 500ms = 30 full cycles at 60Hz.
  #  Staggered update_interval keeps I2C bus quiet --
  #  only one ct_clamp sampling at any given moment.
  #  On ESP32-S3 this staggering is less critical than on
  #  ESP8266 (dedicated core), but it's still good practice.
  # ════════════════════════════════════════════════════════════

  - platform: ct_clamp
    id: current_service_l1
    sensor: raw_service_l1
    name: "Service Entrance L1 Current"
    update_interval: 5s
    sample_duration: 500ms
    accuracy_decimals: 2
    unit_of_measurement: "A"
    device_class: current
    state_class: measurement
    filters:
      - calibrate_linear:
          - 0.0 -> 0.0
          - 1.0 -> 100.0

  - platform: ct_clamp
    id: current_service_l2
    sensor: raw_service_l2
    name: "Service Entrance L2 Current"
    update_interval: 6s
    sample_duration: 500ms
    accuracy_decimals: 2
    unit_of_measurement: "A"
    device_class: current
    state_class: measurement
    filters:
      - calibrate_linear:
          - 0.0 -> 0.0
          - 1.0 -> 100.0

  - platform: ct_clamp
    id: current_generator_l1
    sensor: raw_generator_l1
    name: "Generator L1 Current"
    update_interval: 7s
    sample_duration: 500ms
    accuracy_decimals: 2
    unit_of_measurement: "A"
    device_class: current
    state_class: measurement
    filters:
      - calibrate_linear:
          - 0.0 -> 0.0
          - 1.0 -> 100.0

  - platform: ct_clamp
    id: current_generator_l2
    sensor: raw_generator_l2
    name: "Generator L2 Current"
    update_interval: 8s
    sample_duration: 500ms
    accuracy_decimals: 2
    unit_of_measurement: "A"
    device_class: current
    state_class: measurement
    filters:
      - calibrate_linear:
          - 0.0 -> 0.0
          - 1.0 -> 100.0


  # ════════════════════════════════════════════════════════════
  #  VOLTAGE — RAW ADS1115 CHANNELS
  #
  #  Gain 2.048 on voltage channels.
  #  ZMPT output ~0.20V RMS at ~124V mains.
  #  Peak with ~1.65V DC bias = ~1.93V. Safe within +-2.048V.
  # ════════════════════════════════════════════════════════════

  - platform: ads1115
    id: raw_voltage_l1
    ads1115_id: ads_voltage
    multiplexer: 'A0_GND'
    gain: 2.048
    sample_rate: 860
    update_interval: 1s
    internal: true

  - platform: ads1115
    id: raw_voltage_l2
    ads1115_id: ads_voltage
    multiplexer: 'A1_GND'
    gain: 2.048
    sample_rate: 860
    update_interval: 1s
    internal: true


  # ════════════════════════════════════════════════════════════
  #  VOLTAGE — RMS / CALIBRATED
  # ════════════════════════════════════════════════════════════

  - platform: ct_clamp
    id: voltage_l1
    sensor: raw_voltage_l1
    name: "Service L1 Voltage"
    update_interval: 9s
    sample_duration: 500ms
    accuracy_decimals: 1
    unit_of_measurement: "V"
    device_class: voltage
    state_class: measurement
    filters:
      - calibrate_linear:
          - 0.0 -> 0.0
          - 0.20 -> 124.0

  - platform: ct_clamp
    id: voltage_l2
    sensor: raw_voltage_l2
    name: "Service L2 Voltage"
    update_interval: 10s
    sample_duration: 500ms
    accuracy_decimals: 1
    unit_of_measurement: "V"
    device_class: voltage
    state_class: measurement
    filters:
      - calibrate_linear:
          - 0.0 -> 0.0
          - 0.20 -> 124.0


  # ════════════════════════════════════════════════════════════
  #  POWER — MAINS (apparent, VA)
  # ════════════════════════════════════════════════════════════

  - platform: template
    name: "Service L1 Power"
    id: power_l1
    unit_of_measurement: "W"
    device_class: power
    state_class: measurement
    accuracy_decimals: 0
    update_interval: 11s
    lambda: |-
      return id(voltage_l1).state * id(current_service_l1).state;

  - platform: template
    name: "Service L2 Power"
    id: power_l2
    unit_of_measurement: "W"
    device_class: power
    state_class: measurement
    accuracy_decimals: 0
    update_interval: 12s
    lambda: |-
      return id(voltage_l2).state * id(current_service_l2).state;

  - platform: template
    name: "Total Service Power"
    id: power_total
    unit_of_measurement: "W"
    device_class: power
    state_class: measurement
    accuracy_decimals: 0
    update_interval: 12s
    lambda: |-
      return id(power_l1).state + id(power_l2).state;


  # ════════════════════════════════════════════════════════════
  #  POWER — GENERATOR (apparent, VA)
  # ════════════════════════════════════════════════════════════

  - platform: template
    name: "Generator L1 Power"
    id: power_gen_l1
    unit_of_measurement: "W"
    device_class: power
    state_class: measurement
    accuracy_decimals: 0
    update_interval: 13s
    lambda: |-
      return id(voltage_l1).state * id(current_generator_l1).state;

  - platform: template
    name: "Generator L2 Power"
    id: power_gen_l2
    unit_of_measurement: "W"
    device_class: power
    state_class: measurement
    accuracy_decimals: 0
    update_interval: 14s
    lambda: |-
      return id(voltage_l2).state * id(current_generator_l2).state;

  - platform: template
    name: "Total Generator Power"
    id: power_gen_total
    unit_of_measurement: "W"
    device_class: power
    state_class: measurement
    accuracy_decimals: 0
    update_interval: 14s
    lambda: |-
      return id(power_gen_l1).state + id(power_gen_l2).state;


  # ════════════════════════════════════════════════════════════
  #  GENERATOR LOAD PERCENT
  # ════════════════════════════════════════════════════════════

  - platform: template
    name: "Generator Load Percent"
    id: generator_load_percent
    unit_of_measurement: "%"
    state_class: measurement
    accuracy_decimals: 0
    update_interval: 15s
    lambda: |-
      float total = id(current_generator_l1).state +
                    id(current_generator_l2).state;
      return (total / (${generator_rated_amps} * 2.0)) * 100.0;


  # ════════════════════════════════════════════════════════════
  #  DAILY ENERGY
  #
  #  Based on mains power_total.
  #  If you want generator energy separately, add a second
  #  total_daily_energy sensor pointing at power_gen_total.
  # ════════════════════════════════════════════════════════════

  - platform: total_daily_energy
    name: "Total Daily Energy"
    power_id: power_total
    unit_of_measurement: "kWh"
    device_class: energy
    state_class: total_increasing
    accuracy_decimals: 2
    filters:
      - multiply: 0.001
